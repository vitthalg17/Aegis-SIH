# Leave both Supabase values empty to run in demo mode (sample data, nothing saved to a server).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the public verification page lives, e.g. https://saakshi.netlify.app
VITE_VERIFY_SITE=

# Polygon Amoy RPC (browser friendly) and the deployed SaakshiRegistry
VITE_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
VITE_RPC_FALLBACK=https://polygon-amoy.drpc.org
VITE_REGISTRY=0xA82128628b7Ae42183d9B76020CD37C007c18c46

# Price per node in rupees. Leave empty until the team confirms it from the BOM sheet.
VITE_NODE_PRICE_INR=
